{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/album-memory/profile_claim.schema.json",
  "title": "Profile Claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "dimension_id",
    "horizon",
    "status",
    "statement",
    "value",
    "confidence",
    "review_state",
    "evidence_ids",
    "counter_evidence_ids"
  ],
  "properties": {
    "claim_id": {"type": "string", "format": "uuid"},
    "dimension_id": {"enum": ["S1", "S2", "S3", "S4", "S5", "S6", "S7", "L1", "L2", "L3", "L4", "L5", "L6", "L7", "L8", "L9", "L10"]},
    "horizon": {"enum": ["short", "long"]},
    "status": {"enum": ["candidate", "active", "conflicted", "ended", "rejected", "archived"]},
    "statement": {"type": "string", "minLength": 1, "maxLength": 1000},
    "value": {"type": "object"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "valid_from": {"type": ["string", "null"], "format": "date-time"},
    "valid_to": {"type": ["string", "null"], "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "next_review_at": {"type": ["string", "null"], "format": "date-time"},
    "review_state": {"enum": ["auto_passed", "needs_review", "human_confirmed", "human_rejected"]},
    "supersedes_claim_id": {"type": ["string", "null"], "format": "uuid"},
    "resolution_reason": {"type": ["string", "null"]},
    "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "counter_evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
